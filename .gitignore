# 默认忽略所有内容
*

# Git配置文件
!.gitignore

# 核心代码目录
!losses/
!losses/**
!models/
!models/**

# 可选的根目录代码文件
!README.md
!requirements.txt
!environment.yml
!train_teacher.py
!train_student.py

# Python缓存
**/__pycache__/
*.pyc
*.pyo
*.pyd

# 模型权重
*.pt
*.pth
*.ckpt
*.onnx

# 医学影像及数据
*.nii
*.nii.gz
*.mgz
*.npy
*.npz
*.h5
*.hdf5
*.pkl

# 日志与实验结果
logs/
outputs/
results/
runs/
wandb/
tensorboard/
*.log

# 编辑器和临时文件
.vscode/
.idea/
.cache/
tmp/
temp/
*.swp
