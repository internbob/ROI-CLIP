!/tests/
/tests/*
!/tests/test_cortical_ribbon_sampler.py
!/tests/test_ribbon_geometry.py
!/tests/test_teacher_ribbon_pooling.py
!/tests/test_mri_only_student_contract.py
!/tests/test_cross_geometry_loss.py
!/tests/test_dkt_topology.py
!/tests/test_correspondence_audit.py
!/tests/test_clinical_leakage_audit.py
!/tests/test_development_no_test_access.py
!/tests/test_disease_aware_graph.py
!/tests/test_global_residual_distillation.py
!/tests/test_graph_randomization_gate.py
!/tests/test_graph_stage_a_summary.py
!/tests/test_medicalnet_student_adapter.py
!/tests/test_multiclass_metrics.py
!/tests/test_vnext_graph_student.py

# 保留代码目录
!/losses/
!/losses/**
!/models/
!/models/**

# 无论位于何处，都忽略 Python 缓存
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# 忽略模型权重和大型数据
**/*.pt
**/*.pth
**/*.ckpt
**/*.onnx
**/*.npy
**/*.npz
**/*.h5
**/*.hdf5
**/*.nii
**/*.nii.gz
**/*.mgz
**/*.pkl

# 忽略实验输出
**/logs/
**/outputs/
**/results/
**/runs/
**/wandb/
**/tensorboard/
**/*.log

# 编辑器及缓存
**/.vscode/
**/.idea/
**/.cache/
**/tmp/
**/temp/

# 仅发布去标识化的汇总报告和模板拓扑资产；checkpoint、日志及逐受试者预测继续忽略
