# 默认忽略项目根目录中的所有内容
/*

# 保留 Git 配置
!/.gitignore

# 保留说明及训练脚本
!/README.md
!/train_student.py
!/train_teacher.py
!/requirements.txt
!/environment.yml
!/evaluate.py
!/evaluate_correspondence_audit.py
!/audit_clinical_leakage.py
!/audit_mri_only_graph_student.py
!/audit_student_roi_bottleneck.py
!/analyze_s4_clinical_ablation.py
!/recompute_ablation_classification_metrics.py
!/run_graph_randomization.py
!/summarize_graph_randomization.py
!/summarize_graph_stage_a.py
!/summarize_graph_student.py
!/summarize_graph_student_components.py
!/summarize_med3d_student_ablation.py
!/summarize_roi_bottleneck_ablation.py
!/__init__.py
!/config.py
!/metrics.py
!/options.py
!/utils.py
!/docs/
!/docs/**

# vNext Phase 1 的精确配置、数据接口与测试（其余历史文件仍保持忽略）
!/configs/
/configs/*
!/configs/data.yaml
!/configs/teacher.yaml
!/configs/student.yaml
!/configs/runtime_vnext_phase1_ribbon_fold0.yaml
!/configs/runtime_vnext_phase1_legacy_fold0.yaml
